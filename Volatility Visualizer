from pathlib import Path
import pandas as pd
import matplotlib.pyplot as plt


project_dir = Path (__file__).resolve().parent

input_file = (
    project_dir 
    / "data" 
    / "market_data_volatility.csv"
)

output_dir = project_dir / "charts"
output_dir.mkdir(exist_ok=True)

#=============================================================================

data = pd.read_csv(input_file, parse_dates=["Date"])
data = data.sort_values("Date")

#=============================================================================
plt.figure(figsize=(12,5))

plt.plot(
    data["Date"],
    data["Rolling_Std_20D_Pct"],
    label="Rolling Std 20D (%)"   
)

plt.title("Gold Future - Rolling Volatility (20 Days)")
plt.xlabel("Date")
plt.ylabel("Volatility (%)")
plt.legend()
plt.grid(True, alpha=0.3)
plt.tight_layout()

plt.savefig(
    output_dir / "rolling_volatility.png",
    dpi=150
)

plt.close()

#==========================================================================================
plt.figure(figsize=(12,5))

plt.plot(
    data["Date"],
    data["ATR_14"],
    label ="ATR 14D"
    )
plt.title("Gold Future - Rolling Volatility (20 Days)")
plt.xlabel("Date")
plt.ylabel("ATR (Price Units)")
plt.legend()
plt.grid(True, alpha=0.3)
plt.tight_layout()

plt.savefig(
    output_dir / "atr_14.png",
    dpi=150
)

plt.close()

fig, axes = plt.subplots(
    2, 1,
    figsize=(12,8),
    sharex= True
)

axes[0].plot(
    data["Date"],
    data["Close"],
    label="Close Price"
)

axes[0].set_title("Gold Future - Closing Price")
axes[0].set_ylabel("Price")
axes[0].legend()
axes[0].grid(True, alpha=0.3)

axes[1].plot(
    data["Date"],
    data["Rolling_Std_20D_Pct"],
    label = "Rolling Std 20D (%)"
)

axes[1].set_title("Rolling Volatility")
axes[1].set_xlabel("Date")
axes[1].set_ylabel("Volatility (%)")
axes[1].legend ()
axes[1].grid(True, alpha=0.3)

plt.tight_layout()

plt.savefig(
    output_dir / "price_vs_Volatility.png",
    dpi=150
)
plt.close()
#============================================================================

print("QUANT ANALYTICS - VOLATILITY VISUALIZER")
print(f"Data dibaca: {input_file}")
print(f"Jumlah observasi:{len(data)}")
print(f"Grafik disimpan di:{output_dir}")

print("\nFile yang berhasil dibuat:") 
print("-rolling volatility.png")
print("- atr_14.png")
print("- price_vs_volatility.png")

